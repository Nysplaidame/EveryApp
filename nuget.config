<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only. <clear /> drops any feed set on the machine or user level, and source mapping
     sends every package id to nuget.org, so a package cannot be pulled from another feed by name. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
